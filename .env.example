SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

PROCESS_TEMP_DIR=storage/framework/processes

DB_QUEUE_CONNECTION=pgsql
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

